# Copier ce fichier en .env puis adapter les valeurs
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/merlette
DATABASE_USER=merlette
DATABASE_PASSWORD=merlette
# Au moins 32 caractères
JWT_SECRET=change-me-with-a-long-random-secret-of-32-chars-min
UPLOAD_DIR=uploads
# Motifs d'origines autorisées (localhost + réseau local)
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.*,http://192.168.*,http://172.*
