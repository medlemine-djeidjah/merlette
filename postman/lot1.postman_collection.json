{
  "info": {
    "name": "Merlette — Lot 1 : comptes et observations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API Spring Boot. Exécuter dans l'ordre, avec postman/ comme répertoire de travail. Crée un compte et une observation de démonstration ; aucune suppression des données existantes."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "observationId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "observedAt",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"runId\")) { pm.collectionVariables.set(\"runId\", Date.now().toString()); }",
          "pm.collectionVariables.set(\"observedAt\", new Date().toISOString().slice(0,10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Santé",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Données invalides",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"x\",\n  \"email\": \"invalide\",\n  \"password\": \"court\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Inscription",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"demo_{{runId}}\",\n  \"email\": \"demo_{{runId}}@example.org\",\n  \"password\": \"Secret123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const b=pm.response.json(); pm.collectionVariables.set(\"token\",b.token);",
              "pm.test(\"Rôle utilisateur et aucun hash exposé\",()=>{pm.expect(b.user.role).to.equal(\"USER\");pm.expect(b.user).not.to.have.property(\"passwordHash\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Doublon refusé",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"demo_{{runId}}\",\n  \"email\": \"demo_{{runId}}@example.org\",\n  \"password\": \"Secret123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Mauvais mot de passe",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo_{{runId}}@example.org\",\n  \"password\": \"Mauvais123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Connexion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo_{{runId}}@example.org\",\n  \"password\": \"Secret123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\",pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Session sans token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Session authentifiée",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Catégories",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"categoryId\",pm.response.json()[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Publication sans token",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/observations",
        "body": {
          "mode": "formdata",
          "formdata": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Publication avec photo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/observations",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "categoryId",
              "value": "{{categoryId}}",
              "type": "text"
            },
            {
              "key": "observedAt",
              "value": "{{observedAt}}",
              "type": "text"
            },
            {
              "key": "title",
              "value": "Découverte de démonstration",
              "type": "text"
            },
            {
              "key": "locationName",
              "value": "Parc",
              "type": "text"
            },
            {
              "key": "photos",
              "type": "file",
              "src": "fixtures/bird.jpg"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const b=pm.response.json();pm.collectionVariables.set(\"observationId\",b.id);",
              "pm.test(\"Photo et statut initial\",()=>{pm.expect(b.photos.length).to.equal(1);pm.expect(b.status).to.equal(\"NEEDS_ID\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Détail public",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/observations/{{observationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Fil paginé",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/observations?status=NEEDS_ID&limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Pagination\",()=>pm.expect(pm.response.json().pagination.limit).to.equal(5));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Mes observations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/users/me/observations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Pagination invalide",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/observations?page=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Observation inconnue",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/observations/2147483647"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
