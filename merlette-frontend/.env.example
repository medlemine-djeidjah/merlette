# Développement : le navigateur utilise Vite et Vite transmet les appels au backend.
VITE_API_URL=/api
MERLETTE_API_TARGET=http://localhost:8080
# Pour le serveur partagé : MERLETTE_API_TARGET=http://10.86.216.74:8080
# Swagger partagé : http://10.86.216.74:8080/docs

# Activer chaque module uniquement lorsque ses endpoints sont implémentés.
VITE_IDENTIFICATION_ENABLED=false
VITE_COMMENTS_ENABLED=false
VITE_NOTIFICATIONS_ENABLED=false
VITE_PROFILES_ENABLED=false
VITE_CONVERSATIONS_ENABLED=false
VITE_MANAGEMENT_ENABLED=false
VITE_DELETION_ENABLED=true
VITE_ADMINISTRATION_ENABLED=false
